{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "DnsEngine": {
    "ListenAddress": {
      "Enabled": true,
      "Address": "0.0.0.0",
      "Port": 53
    },
    "ProcessingThreads": 4,
    "MaxCacheEntries": 100000,
    "LocalDomainSuffix": ".lan",
    "UpstreamResolvers": [
      "1.1.1.1",
      "8.8.8.8",
      "9.9.9.9"
    ],
    "PtrRecords": {
      "100.1.168.192.in-addr.arpa": "server.lan"
    },
    "ConditionalPtrRules": [
      {
        "Subnet": "192.168.1.0/24",
        "TargetResolver": "192.168.1.1"
      }
    ],
    "BlockedResponseMode": "Refused",
    "CustomBlockedIp": "0.0.0.0"
  },
  "HostsFiles": {
    "Sources": []
  },
  "DomainFilterRules": {
    "AllowListSources": [],
    "BlockListSources": []
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=/var/lib/astrolabed/astrolabed.db;Cache=Shared;Mode=ReadWriteCreate",
    "CommandTimeoutSeconds": 5
  },
  "NetworkScanner": {
    "MaxDegreeOfParallelism": 1000,
    "PingTimeoutMs": 200
  },
  "NtpServer": {
    "ListenAddress": {
      "Enabled": true,
      "Address": "0.0.0.0",
      "Port": 123
    },
    "Stratum": 1,
    "ReferenceIdentifier": "LOCL",
    "Precision": -20,
    "PollInterval": 4,
    "RootDelay": 0,
    "RootDispersion": 0,
    "ResolverMode": "Upstream",
    "UpstreamServers": [
      "pool.ntp.org",
      "time.nist.gov",
      "time.google.com"
    ],
    "UpstreamPort": 123,
    "UpstreamTimeoutMilliseconds": 3000,
    "UpstreamSyncIntervalSeconds": 60
  },
  "DhcpServer": {
    "ListenAddress": {
      "Enabled": true,
      "Address": "0.0.0.0",
      "Port": 67
    },
    "TestMode": false,
    "TestPort": 6767,
    "ServerIp": "192.168.1.1",
    "SubnetMask": "255.255.255.0",
    "Router": "192.168.1.1",
    "DnsServer": "192.168.1.202",
    "NtpServer": "192.168.1.202",
    "DomainName": "lan",
    "StartIpAddress": "192.168.1.100",
    "EndIpAddress": "192.168.1.200",
    "LeaseTimeSeconds": 86400
  },
  "Api": {
    "ApiEndpoint": "http://0.0.0.0:8001/api",
    "Enabled": true,
    "TimeoutSeconds": 30,
    "EnableDetailedErrors": true
  }
}
