// File: appsettings.json
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "DnsEngine": {
    "Port": 1053,
    "ProcessingThreads": 4,
    "MaxCacheEntries": 100000,
    "LocalDomainSuffix": ".lan",
    "UpstreamResolvers": [
      "1.1.1.1",
      "8.8.8.8",
      "9.9.9.9"
    ],
    "Hosts": {
      "router.lan": "192.168.1.1",
      "nas.lan": "192.168.1.10",
      "pihole.lan": "192.168.1.15",
      "server.lan": "192.168.1.100"
    },
    "PtrRecords": {
      "1.1.168.192.in-addr.arpa": "router.lan",
      "10.1.168.192.in-addr.arpa": "nas.lan",
      "15.1.168.192.in-addr.arpa": "pihole.lan",
      "100.1.168.192.in-addr.arpa": "server.lan"
    },
    "BlockedDomains": [
      "ads.badsite.com",
      "telemetry.tracker.io",
      "malware.known-bad.net"
    ]
  }
}
