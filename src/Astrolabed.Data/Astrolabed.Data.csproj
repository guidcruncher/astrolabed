<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Astrolabed.Data</RootNamespace>
    <AssemblyName>Astrolabed.Data</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Guidcruncher</Authors>
    <Description>Astrolabed Data Layer</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\DatabaseSchema.sql" />
  </ItemGroup>

  <ItemGroup>
