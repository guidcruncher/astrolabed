{
  "Dns": {
    "Listen": {
      "Address": "0.0.0.0",
      "Port": 1053
    },
    "UpstreamTimeoutMs": 1500,
    "DefaultResolvers": [
      {
        "Name": "Cloudflare",
        "Address": "1.1.1.1",
        "Port": 53
      },
      {
        "Name": "Cloudflare Secondary",
        "Address": "1.0.0.1",
        "Port": 53
      }
    ],
    "Resolvers": [],
    "Blocklists": [],
    "Allowlists": [],
    "HostsFiles": [
      "file:///dns-hosts/custom.list"
    ],
    "Caching": {
      "Enabled": true,
      "TtlSeconds": 300,
      "MaxEntries": 2000,
      "CleanupIntervalMinutes": 5
    },
    "BlockResponse": {
      "Mode": "NXDOMAIN",
      "StaticIp": "0.0.0.0",
      "Ttl": 60
    }
  },
  "Dhcp": {
    "Enabled": false,
    "ListenAddress": "0.0.0.0",
    "ListenPort": 1067,
    "LeaseStorePath": "/var/lib/astrolabed/leases.json",
    "PoolCidr": "192.168.1.0/24",
    "ServerIdentifier": "192.168.1.202",
    "Router": "192.168.1.1",
    "DnsServer": "192.168.1.202",
    "NtpServer": "192.168.1.202",
    "WebProxyServerUrl": "0.0.0.0",
    "LeaseHours": 1,
    "ArpTimeoutMs": 500,
    "BadIpStorePath": "/var/lib/astrolabed/badips.json"
  },
  "Ntp": {
    "Enabled": true,
    "ListenAddress": "0.0.0.0",
    "Port": 1123,
    "BufferSize": 65536,
    "Stratum": 1,
    "ReferenceId": "LOCL",
    "Upstream": {
      "Enabled": true,
      "Servers": [
        "0.pool.ntp.org",
        "1.pool.ntp.org"
      ],
      "PollIntervalSeconds": 16
    }
  },
  "Metrics": {
    "Enabled": true,
    "StorageEngine": "prometheus",
    "Location": "/metrics",
    "ListenAddress": "0.0.0.0",
    "ListenPort": 1080
  },
  "WebUI": {
    "Enabled": true,
    "ListenAddress": "127.0.0.1",
    "ListenPort": 1081
  },
  "Logging": {
    "Level": "Information"
  }
}
