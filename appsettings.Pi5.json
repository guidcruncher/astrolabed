// File: appsettings.json
{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Astrolabed.Dns": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "DnsEngine": {
    "Port": 53,
    "ProcessingThreads": 4,
    "SocketReceiveBufferSize": 16777216,
    "SocketSendBufferSize": 16777216,
    "MaxCacheEntries": 500000,
    "CacheEvictionBatchSize": 2048,
    "EnableLockFreeCache": true,
    "LocalDomainSuffix": ".lan",
    "UpstreamResolvers": [
      "1.1.1.1",
      "1.0.0.1",
      "8.8.8.8"
    ],
    "UpstreamTimeoutMilliseconds": 1500,
    "Hosts": {
      "router.lan": "192.168.1.1",
      "pi5.lan": "192.168.1.5",
      "nas.lan": "192.168.1.10",
      "server.lan": "192.168.1.100"
    },
    "PtrRecords": {
      "1.1.168.192.in-addr.arpa": "router.lan",
      "5.1.168.192.in-addr.arpa": "pi5.lan",
      "10.1.168.192.in-addr.arpa": "nas.lan",
      "100.1.168.192.in-addr.arpa": "server.lan"
    },
    "BlockedDomains": [
      "ads.badsite.com",
      "telemetry.tracker.io",
      "malware.known-bad.net"
    ]
  }
}
