{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Astrolabed.Dns": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "DnsEngine": {
    "ListenAddress": {
      "Enabled": true,
      "Address": "0.0.0.0",
      "Port": 53
    },
    "ProcessingThreads": 4,
    "SocketReceiveBufferSize": 16777216,
    "SocketSendBufferSize": 16777216,
    "MaxCacheEntries": 500000,
    "CacheEvictionBatchSize": 2048,
    "EnableLockFreeCache": true,
    "LocalDomainSuffix": ".lan",
    "UpstreamResolvers": [
      "1.1.1.1",
      "1.0.0.1",
      "8.8.8.8"
    ],
    "UpstreamTimeoutMilliseconds": 1500,
    "PtrRecords": {},
    "ConditionalPtrRules": [
      {
        "Subnet": "192.168.1.0/24",
        "TargetResolver": "192.168.1.1"
      }
    ],
    "BlockedResponseMode": "Refused",
    "CustomBlockedIp": "0.0.0.0"
  },
  "HostsFiles": {
    "Sources": []
  },
  "DomainFilterRules": {
    "AllowListSources": [],
    "BlockListSources": []
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=/var/lib/astrolabed/astrolabed.db;Cache=Shared",
    "CommandTimeoutSeconds": 30
  },
  "NetworkScanner": {
    "MaxDegreeOfParallelism": 1000,
    "PingTimeoutMs": 200
  },
  "NtpServer": {
    "ListenAddress": {
      "Enabled": true,
      "Address": "0.0.0.0",
      "Port": 123
    },
    "Stratum": 1,
    "ReferenceIdentifier": "LOCL",
    "Precision": -20,
    "PollInterval": 4,
    "RootDelay": 0,
    "RootDispersion": 0,
    "ResolverMode": "Upstream",
    "UpstreamServers": [
      "pool.ntp.org",
      "time.nist.gov",
      "time.google.com"
    ],
    "UpstreamPort": 123,
    "UpstreamTimeoutMilliseconds": 3000,
    "UpstreamSyncIntervalSeconds": 60
  }
}
