{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Astrolabed.Dns": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "DnsEngine": {
    "ListenAddress": {
      "Enabled": true,
      "Address": "0.0.0.0",
      "Port": 1053
    },
    "ProcessingThreads": 4,
    "SocketReceiveBufferSize": 16777216,
    "SocketSendBufferSize": 16777216,
    "MaxCacheEntries": 500000,
    "CacheEvictionBatchSize": 2048,
    "EnableLockFreeCache": true,
    "LocalDomainSuffix": ".lan",
    "UpstreamResolvers": [
      "1.1.1.1",
      "1.0.0.1",
      "8.8.8.8"
    ],
    "UpstreamTimeoutMilliseconds": 1500,
    "PtrRecords": {
      "100.1.168.192.in-addr.arpa": "server.lan"
    },
    "ConditionalPtrRules": [
      {
        "Subnet": "192.168.1.0/24",
        "TargetResolver": "192.168.1.1"
      }
    ],
    "BlockedResponseMode": "Refused",
    "CustomBlockedIp": "0.0.0.0"
  },
  "HostsFiles": {
    "Sources": [
      "file://../netdns-runtime/dns-hosts/custom.list"
    ]
  },
  "DomainFilterRules": {
    "AllowListSources": [
    ],
    "BlockListSources": [
      "file://../netdns-runtime/dns-lists/block.list",
      "https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts"
    ]
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=../netdns-runtime/astrolabed.db;Cache=Shared",
    "CommandTimeoutSeconds": 30
  },
  "NetworkScanner": {
    "MaxDegreeOfParallelism": 1000,
    "PingTimeoutMs0": 200
  }
}
