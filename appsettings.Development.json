{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Astrolabed.Dns": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "DnsEngine": {
    "ListenAddress": {
      "Enabled": true,
      "Address": "0.0.0.0",
      "Port": 1053
    },
    "ProcessingThreads": 4,
    "SocketReceiveBufferSize": 16777216,
    "SocketSendBufferSize": 16777216,
    "MaxCacheEntries": 500000,
    "CacheEvictionBatchSize": 2048,
    "EnableLockFreeCache": true,
    "LocalDomainSuffix": ".lan",
    "UpstreamResolvers": [
      "185.222.222.222",
      "45.11.45.11"
    ],
    "UpstreamTimeoutMilliseconds": 1500,
    "PtrRecords": {
      "100.1.168.192.in-addr.arpa": "server.lan"
    },
    "ConditionalPtrRules": [
      {
        "Subnet": "192.168.1.0/24",
        "TargetResolver": "192.168.1.1"
      }
    ],
    "BlockedResponseMode": "Refused",
    "CustomBlockedIp": "0.0.0.0"
  },
  "HostsFiles": {
    "Sources": [
      "file://../netdns-runtime/dns-hosts/custom.list"
    ]
  },
  "DomainFilterRules": {
    "AllowListSources": [],
    "BlockListSources": [
      {
        "Id": 1,
        "Path": "file://../netdns-runtime/dns-lists/block.list"
      },
      {
        "Id": 2,
        "Path": "https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts"
      }
    ]
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=../netdns-runtime/astrolabed.db;Cache=Shared;Mode=ReadWriteCreate",
    "CommandTimeoutSeconds": 5
  },
  "NetworkScanner": {
    "MaxDegreeOfParallelism": 1000,
    "PingTimeoutMs": 200,
    "Gateway": "192.168.1.1"
  },
  "NtpServer": {
    "ListenAddress": {
      "Enabled": true,
      "Address": "0.0.0.0",
      "Port": 1123
    },
    "Stratum": 1,
    "ReferenceIdentifier": "LOCL",
    "Precision": -20,
    "PollInterval": 4,
    "RootDelay": 0,
    "RootDispersion": 0,
    "ResolverMode": "Upstream",
    "UpstreamServers": [
      "pool.ntp.org",
      "time.nist.gov",
      "time.google.com"
    ],
    "UpstreamPort": 123,
    "UpstreamTimeoutMilliseconds": 3000,
    "UpstreamSyncIntervalSeconds": 60
  },
  "DhcpServer": {
    "ListenAddress": {
      "Enabled": true,
      "Address": "0.0.0.0",
      "Port": 67
    },
    "TestMode": true,
    "TestPort": 1167,
    "ServerIp": "192.168.1.202",
    "SubnetMask": "255.255.255.0",
    "Router": "192.168.1.1",
    "DnsServer": "192.168.1.202",
    "NtpServer": "192.168.1.202",
    "DomainName": "lan",
    "StartIpAddress": "192.168.1.100",
    "EndIpAddress": "192.168.1.200",
    "LeaseTimeSeconds": 86400
  },
  "Api": {
    "ApiEndpoint": "http://0.0.0.0:8001",
    "Enabled": true,
    "TimeoutSeconds": 30,
    "EnableDetailedErrors": true
  },
  "DnsBenchmark": {
    "QueryDomain": "example.com",
    "WarmupCount": 1,
    "Iterations": 5,
    "TimeoutMilliseconds": 2000
  }
}
